# Copy to apps/web/.env.local. Both values are browser-safe, protected by RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Vite automatically configures the repo base path in vite.config.ts.

# Copy the following to apps/obs-bridge/.env, not the web folder.
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=SET_LOCALLY_NEVER_COMMIT
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only for first registration
BRIDGE_REGISTRATION_CODE=
# Registration saves the bridge bearer token into local bridge-config.json.
