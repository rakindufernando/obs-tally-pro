{
  "name": "@tally/obs-bridge",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "package:win": "npm run build && pkg . --targets node22-win-x64 --output ../../dist/obs-tally-bridge.exe",
    "package:portable": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/bridge.cjs"
  },
  "bin": "./dist/index.js",
  "dependencies": {
    "@tally/shared": "3.1.0",
    "obs-websocket-js": "^5.0.7",
    "dotenv": "^16.6.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "@yao-pkg/pkg": "^6.5.1",
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12"
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ]
  }
}
